  "main": "index.ts",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  },
  "scripts": {
    "start": "expo start --dev-client",
    "start:web": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "export:web": "expo export --platform web --max-workers 1",
    "export:all": "expo export --platform all --max-workers 1",
    "doctor": "expo-doctor",
    "native:prepare:android": "node modules/hongguo-source/scripts/build.mjs android",
    "native:prepare:ios": "node modules/hongguo-source/scripts/build.mjs ios",
    "package:source": "node scripts/package-source.mjs"
